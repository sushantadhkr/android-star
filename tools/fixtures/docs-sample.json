\":\"get\"}","exampleResponse":"{\"accelX\":0.12,\"lightLux\":142.0,\"pressureHpa\":1013.2}"}]},{"id":"CONNECTIVITY","displayName":"Network & Wi-Fi Telemetry","description":"Live Wi-Fi IP, MAC/Interface, link speed, frequency, and gateway telemetry","group":"CONNECTIVITY","groupName":"Connectivity & Files","summary":"Network state and Wi-Fi telemetry","requiredPermissions":["android.permission.INTERNET","android.permission.ACCESS_NETWORK_STATE","android.permission.ACCESS_WIFI_STATE"],"actions":[{"name":"get","summary":"Read the current network state","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"CONNECTIVITY\",\"action\":\"get\"}","exampleResponse":"{\"isConnected\":true,\"isWifi\":true,\"ssid\":\"Home\",\"linkSpeedMbps\":866}"}]},{"id":"WIFI","displayName":"Wi-Fi & Wi-Fi Direct","description":"Scan, connect, Wi-Fi Direct (P2P), and soft AP hotspot status","group":"CONNECTIVITY","groupName":"Connectivity & Files","summary":"Wi-Fi state and Wi-Fi Direct peers","requiredPermissions":["android.permission.ACCESS_WIFI_STATE","android.permission.CHANGE_WIFI_STATE"],"actions":[{"name":"state","summary":"Whether Wi-Fi is on, and how many Direct peers are known","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"WIFI\",\"action\":\"state\"}","exampleResponse":"{\"enabled\":true,\"peers\":0}"},{"name":"peers","summary":"Discover Wi-Fi Direct peers","requiresUserConsent":true,"params":[],"exampleRequest":"{\"capability\":\"WIFI\",\"action\":\"peers\"}","exampleResponse":"{\"peers\":2}"}]},{"id":"NETWORK_USAGE","displayName":"Network Data Usage","description":"Historical and real-time mobile and Wi-Fi data usage per application","group":"CONNECTIVITY","groupName":"Connectivity & Files","summary":"Data used over mobile and Wi-Fi","requiredPermissions":[],"actions":[{"name":"get","summary":"Read traffic counters","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"NETWORK_USAGE\",\"action\":\"get\"}","