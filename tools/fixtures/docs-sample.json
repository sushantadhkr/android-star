{"title":"Android Star — Capabilities API","authentication":"Send 'Authorization: Bearer <token>'.","appRoutes":[],"capabilities":[{"id":"DEVICE_ACTIONS","displayName":"Device Controls & Haptics","description":"Haptics, flashlight/torch, battery telemetry, and power metrics","group":"DEVICE","groupName":"Device & System","summary":"Haptics, torch and device controls","requiredPermissions":["android.permission.VIBRATE"],"actions":[{"name":"haptic","summary":"Vibrate the device","requiresUserConsent":false,"params":[{"name":"durationMs","type":"integer","required":false,"description":"How long to buzz","example":"200"}],"exampleRequest":"{\"capability\":\"DEVICE_ACTIONS\",\"action\":\"haptic\",\"durationMs\":200}","exampleResponse":"{\"vibrated\":200}"},{"name":"torch","summary":"Turn the torch on or off","requiresUserConsent":false,"params":[{"name":"enabled","type":"boolean","required":false,"description":"Whether the torch should be on","example":"true"}],"exampleRequest":"{\"capability\":\"DEVICE_ACTIONS\",\"action\":\"torch\",\"enabled\":true}","exampleResponse":"{\"torch\":true}"}]},{"id":"VIBRATION_HAPTICS","displayName":"Vibration & Haptic Feedback","description":"Custom vibration waveforms, click patterns, and rich haptic effects","group":"DEVICE","groupName":"Device & System","summary":"Haptic feedback","requiredPermissions":["android.permission.VIBRATE"],"actions":[{"name":"pulse","summary":"Vibrate the device","requiresUserConsent":false,"params":[{"name":"durationMs","type":"integer","required":false,"description":"How long to buzz","example":"200"}],"exampleRequest":"{\"capability\":\"VIBRATION_HAPTICS\",\"action\":\"pulse\",\"durationMs\":200}","exampleResponse":"{\"vibrated\":200}"}]},{"id":"NOTIFICATIONS","displayName":"System Notifications","description":"High-priority, status, and categorized channel notifications","group":"DISPLAY","groupName":"Display & Alerts","summary":"Post a notification to the shade","requiredPermissions":[],"actions":[{"name":"post","summary":"Show a notification, tappable to a link and with inline action buttons","requiresUserConsent":false,"params":[{"name":"title","type":"string","required":true,"description":"Notification title","example":"Hello"},{"name":"message","type":"string","required":false,"description":"Body text","example":"from curl"},{"name":"priorityHigh","type":"boolean","required":false,"description":"Use the high-priority channel","example":"false"},{"name":"link","type":"string","required":false,"description":"http/https URL opened when tapped. Omit it to open the app instead.","example":"https://ci.example.com/build/482"},{"name":"buttons","type":"array","required":false,"description":"Inline buttons, at most 3: [{id, label, icon?, input?, invoke?}] where icon is one of check|alarm|reply|delete|refresh|open, input is {key, hint} for a reply field, and invoke is \"CAPABILITY:action\" (or \"CAPABILITY:action:param\" to send typed text there). Pressing a button is still subject to every capability's switch.","example":"[{\"id\":\"snooze\",\"label\":\"Snooze\",\"icon\":\"alarm\",\"invoke\":\"ALARM_TIMER:set:minutes\"},{\"id\":\"reply\",\"label\":\"Reply\",\"icon\":\"reply\",\"input\":{\"key\":\"text\",\"hint\":\"Type a reply\"},\"invoke\":\"NOTIFICATIONS:post:text\"}]"}],"exampleRequest":"{\"capability\":\"NOTIFICATIONS\",\"action\":\"post\",\"title\":\"Build passed\",\"message\":\"Tap to view\",\"link\":\"https://ci.example.com/build/482\",\"buttons\":[{\"id\":\"done\",\"label\":\"Mark done\",\"icon\":\"check\",\"invoke\":\"CLIPBOARD:write\"}]}","exampleResponse":"{\"posted\":true,\"id\":4211,\"opensLink\":true,\"buttonsShown\":1,\"buttonsDropped\":[]}"},{"name":"buttonLog","summary":"Read the notification buttons pressed on this device, newest first","requiresUserConsent":false,"params":[{"name":"limit","type":"integer","required":false,"description":"How many presses to return","example":"10"}],"exampleRequest":"{\"capability\":\"NOTIFICATIONS\",\"action\":\"buttonLog\",\"limit\":5}","exampleResponse":"{\"count\":1,\"presses\":[{\"buttonId\":\"done\",\"label\":\"Mark done\",\"notificationTitle\":\"Build passed\",\"typedText\":null,\"invokeTarget\":\"CLIPBOARD:write\",\"invokeStatus\":200,\"at\":1752000000000}]}"}]},{"id":"SMS","displayName":"SMS & Messaging","description":"Read and inspect SMS inbox and messages","group":"COMMUNICATION","groupName":"Communication","summary":"Read the SMS inbox","requiredPermissions":["android.permission.READ_SMS"],"actions":[{"name":"count","summary":"How many messages the inbox holds","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"SMS\",\"action\":\"count\"}","exampleResponse":"{\"count\":214}"},{"name":"list","summary":"Read recent inbox messages, newest first","requiresUserConsent":false,"params":[{"name":"limit","type":"integer","required":false,"description":"How many messages, 1-200","example":"20"},{"name":"search","type":"string","required":false,"description":"Only messages whose body or sender contains this","example":"invoice"}],"exampleRequest":"{\"capability\":\"SMS\",\"action\":\"list\",\"limit\":3}","exampleResponse":"{\"count\":3,\"messages\":[{\"id\":41,\"address\":\"+441234\",\"body\":\"Invoice ready\",\"date\":1752000000000,\"type\":\"inbox\",\"read\":false}]}"},{"name":"read","summary":"Read one message by its id","requiresUserConsent":false,"params":[{"name":"id","type":"integer","required":true,"description":"The message id, as returned by list","example":"41"}],"exampleRequest":"{\"capability\":\"SMS\",\"action\":\"read\",\"id\":41}","exampleResponse":"{\"id\":41,\"address\":\"+441234\",\"body\":\"Invoice ready\",\"date\":1752000000000,\"type\":\"inbox\",\"read\":false}"}]},{"id":"CLIPBOARD","displayName":"Clipboard Manager","description":"Secure clipboard read and write with privacy awareness","group":"DATA","groupName":"Data & Automation","summary":"Read and write the clipboard","requiredPermissions":[],"actions":[{"name":"read","summary":