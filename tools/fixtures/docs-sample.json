ations","group":"DEVICE","groupName":"Device & System","summary":"Read system and secure settings","requiredPermissions":[],"actions":[{"name":"get","summary":"Read a system setting","requiresUserConsent":false,"params":[{"name":"key","type":"string","required":true,"description":"Setting name, e.g. airplane_mode_on","example":"airplane_mode_on"}],"exampleRequest":"{\"capability\":\"SYSTEM_SETTINGS\",\"action\":\"get\",\"key\":\"airplane_mode_on\"}","exampleResponse":"{\"value\":\"0\"}"},{"name":"getsecure","summary":"Read a secure setting","requiresUserConsent":false,"params":[{"name":"key","type":"string","required":true,"description":"Setting name","example":"android_id"}],"exampleRequest":"{\"capability\":\"SYSTEM_SETTINGS\",\"action\":\"getsecure\",\"key\":\"android_id\"}","exampleResponse":"{\"value\":\"...\"}"}]},{"id":"FLASHLIGHT","displayName":"Flashlight / Torch","description":"Camera LED torch control and brightness strobe patterns","group":"DISPLAY","groupName":"Display & Alerts","summary":"Torch control","requiredPermissions":["android.permission.CAMERA"],"actions":[{"name":"on","summary":"Turn the torch on","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"FLASHLIGHT\",\"action\":\"on\"}","exampleResponse":"{\"on\":true}"},{"name":"off","summary":"Turn the torch off","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"FLASHLIGHT\",\"action\":\"off\"}","exampleResponse":"{\"on\":false}"},{"name":"toggle","summary":"Flip the torch","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"FLASHLIGHT\",\"action\":\"toggle\"}","exampleResponse":"{\"on\":true}"},{"name":"state","summary":"Whether the torch is on","requiresUserConsent":false,"params":[],"exampleRequest":"{\"capability\":\"FLASHLIGHT\",\"action\":\"state\"}","exampleResponse":"{\"on\":false}"}]},{"id":"DISPLAY","displayName":"Display & Screen","description":"Brightness, screen orientation, refresh rate, and display metrics","