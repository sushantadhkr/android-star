Request":"{\"capability\":\"CAMERA\",\"action\":\"stop\"}","exampleResponse":"{\"file\":\"/data/.../video-1752.mp4\",\"bytes\":88213}"}]},{"id":"MICROPHONE","displayName":"Microphone & Audio Capture","description":"Audio recording capabilities and sensor analysis","group":"CAPTURE","groupName":"Camera & Audio","summary":"Record audio","requiredPermissions":["android.permission.RECORD_AUDIO"],"actions":[{"name":"record","summary":"Record PCM audio to a file","requiresUserConsent":true,"params":[{"name":"durationMs","type":"integer","required":false,"description":"How long to record","example":"2000"}],"exampleRequest":"{\"capability\":\"MICROPHONE\",\"action\":\"record\",\"durationMs\":3000}","exampleResponse":"{\"file\":\"...audio-1752.pcm\",\"bytes\":96000,\"durationMs\":3000,\"format\":\"pcm_16bit_mono_16khz\"}"}]},{"id":"QR_BARCODE","displayName":"QR & Barcode Utilities","description":"Generate and parse QR codes and 1D/2D barcodes","group":"CAPTURE","groupName":"Camera & Audio","summary":"Generate and read QR codes and barcodes","requiredPermissions":[],"actions":[{"name":"generate","summary":"Encode text as a scannable QR and save it as PNG","requiresUserConsent":false,"params":[{"name":"content","type":"string","required":true,"description":"Text to encode","example":"hello"},{"name":"size","type":"integer","required":false,"description":"Pixel size of the square image","example":"512"}],"exampleRequest":"{\"capability\":\"QR_BARCODE\",\"action\":\"generate\",\"content\":\"hello\"}","exampleResponse":"{\"file\":\"/data/.../exports/qr-1752.png\"}"},{"name":"decode","summary":"Read a barcode out of an image","requiresUserConsent":false,"params":[{"name":"file","type":"string","required":true,"description":"Absolute path to an image, e.g. a camera capture","example":"/data/.../capture.jpg"}],"exampleRequest":"{\"capability\":\"QR_BARCODE\",\"action\":\"decode\",\"file\":\"/data/.../capture.jpg\"}","exampleResponse":"{\"content\":\"hello\"}"}]},{"id":"SCREEN_CAPTU