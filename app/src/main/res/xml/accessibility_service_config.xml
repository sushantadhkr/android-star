<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android Star is allowed to see and do through the accessibility service.

  Deliberately narrow. canRetrieveWindowContent is off: this platform dispatches taps, it does not
  read other apps' screens. canPerformGestures is on because that is the whole point. Anything that
  would let the platform observe what is on screen — screen capture, magnification — is left out, so
  a user enabling this in Settings is agreeing to input injection and nothing more.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />